# Comma-separated browser origins allowed to call this API (no trailing slash needed).
ALLOWED_ORIGINS=http://localhost:5173

# MongoDB Atlas: stores contact messages and the resume PDF. Optional for messages
# (email still works without it) but REQUIRED for resume upload/download.
MONGODB_URI=
MONGODB_DB_NAME=portfolio

# Gmail API over HTTPS (works on Render's free tier; SMTP ports are blocked there).
# Create these with: python scripts/get_gmail_refresh_token.py  (see README)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com        # the Gmail account that authorised the token
NOTIFY_EMAIL=you@gmail.com        # inbox that receives contact notifications

# Base64 encoding of 32 raw Ed25519 public-key bytes (generated locally).
ADMIN_PUBLIC_KEY_B64=
